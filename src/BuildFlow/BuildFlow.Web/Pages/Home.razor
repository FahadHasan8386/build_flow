@page "/"

<PageTitle>BuildFlow</PageTitle>

<section class="hero p-5 rounded-4 shadow-sm">
    <div class="container-fluid p-0">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3">Ship work faster with a secure delivery workspace.</h1>
                <p class="lead text-muted mb-4">BuildFlow brings tenant-based collaboration, authentication, and planning into one modern experience for product and engineering teams.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="/register">Create account</a>
                    <a class="btn btn-outline-primary" href="/login">Sign in</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="card-title">Why teams choose BuildFlow</h5>
                        <ul class="mb-0 text-muted">
                            <li>Secure JWT authentication</li>
                            <li>Tenant-aware onboarding</li>
                            <li>Clean, modern dashboard experience</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
