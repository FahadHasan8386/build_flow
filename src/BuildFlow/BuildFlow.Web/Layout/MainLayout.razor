@inherits LayoutComponentBase
@using BuildFlow.Web.Services.Auth
@implements IDisposable

@inject IAuthService Auth
@inject INotificationService NotificationService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end">
            @if (!Auth.IsAuthenticated)
            {
                <NavLink class="nav-link me-3 text-dark fw-semibold" href="/login">
                    Login
                </NavLink>

                <NavLink class="btn btn-primary btn-sm" href="/register">
                    Register
                </NavLink>
            }
            else
            {
                @* Notification Bell Component *@
                <div class="dropdown me-3 position-relative">
                    <button class="btn btn-light border-0 rounded-circle p-2 shadow-sm" @onclick="ToggleNotifications">
                        🔔
                        @if (unreadCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @unreadCount
                            </span>
                        }
                    </button>

                    @if (showNotifications)
                    {
                        <div class="dropdown-menu dropdown-menu-end show p-2 shadow-lg border-secondary position-absolute mt-2" style="width: 300px; right: 0; z-index: 1050;">
                            <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                                <h6 class="m-0 fw-bold">Notifications</h6>
                                <button class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="MarkAllRead">Mark all read</button>
                            </div>
                            <hr class="my-1" />
                            @if (notifications.Any())
                            {
                                <div style="max-height: 250px; overflow-y: auto;">
                                    @foreach (var item in notifications)
                                    {
                                        <div class="p-2 border-bottom small @(item.IsRead ? "opacity-75" : "fw-bold bg-light")">
                                            <div>@item.Title</div>
                                            <div class="text-muted extra-small">@item.Message</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted small">No notifications found.</div>
                            }
                        </div>
                    }
                </div>

                <span class="fw-semibold me-2 text-dark">@Auth.UserEmail</span>
            }
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

@code {
    private int unreadCount = 0;
    private bool showNotifications = false;
    private List<BuildFlow.Web.Models.NotificationDto> notifications = new();

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        Auth.AuthChanged += OnAuthChanged;

        if (Auth.IsAuthenticated)
        {
            await LoadNotificationsData();
        }
    }

    private async Task LoadNotificationsData()
    {
        unreadCount = await NotificationService.GetUnreadCountAsync();
    }

    private async Task ToggleNotifications()
    {
        showNotifications = !showNotifications;
        if (showNotifications)
        {
            notifications = await NotificationService.GetNotificationsAsync();
        }
    }

    private async Task MarkAllRead()
    {
        await NotificationService.MarkAllAsReadAsync();
        unreadCount = 0;
        notifications.ForEach(n => n.IsRead = true);
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Auth.IsAuthenticated)
            {
                await LoadNotificationsData();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.AuthChanged -= OnAuthChanged;
    }
}