@using BuildFlow.Web.Services
@using BuildFlow.Web.Services.Auth

@inject IAuthService Auth
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid px-3 px-lg-4">

        <!-- Brand -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
           href="/">
            <span class="brand-icon">🏗️</span>
            <span>BuildFlow</span>
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#buildFlowNavbar"
                aria-controls="buildFlowNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="buildFlowNavbar">

            <!-- Left Navigation -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <!-- Home -->
                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="/"
                             Match="NavLinkMatch.All">

                        Home
                    </NavLink>
                </li>

                @if (Auth.IsAuthenticated)
                {
                    <!-- Dashboard -->
                    <li class="nav-item">
                        <NavLink class="nav-link"
                                 href="/dashboard">

                            Dashboard
                        </NavLink>
                    </li>

                    <!-- Projects -->
                    <li class="nav-item">
                        <NavLink class="nav-link"
                                 href="/projects">

                            Projects
                        </NavLink>
                    </li>

                    <!-- Tasks -->
                    <li class="nav-item">
                        <NavLink class="nav-link"
                                 href="/tasks">

                            Tasks
                        </NavLink>
                    </li>

                    <!-- Team -->
                    <li class="nav-item">
                        <NavLink class="nav-link"
                                 href="/users">
                            Team
                        </NavLink>
                    </li>
                }
            </ul>

            <!-- Right Side -->
            <div class="d-flex align-items-center gap-2">

                @if (Auth.IsAuthenticated)
                {
                    <!-- Notifications -->
                    <div class="nav-notification">
                        <NotificationBell />
                    </div>

                    <!-- User Dropdown -->
                    <div class="dropdown">

                        <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                                type="button"
                                id="userMenuDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <!-- User Icon -->
                            <span class="user-avatar">
                                @GetInitial()
                            </span>

                            <span class="d-none d-md-inline">
                                @GetDisplayName()
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow"
                            aria-labelledby="userMenuDropdown">

                            <!-- User Info -->
                            <li>
                                <div class="dropdown-header">

                                    <div class="fw-semibold">
                                        @GetDisplayName()
                                    </div>

                                    <small class="text-muted">
                                        @Auth.UserEmail
                                    </small>

                                </div>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <!-- Profile -->
                            <li>
                                <a class="dropdown-item"
                                   href="/users">
                                    My Profile
                                </a>
                            </li>

                            <!-- Dashboard -->
                            <li>
                                <a class="dropdown-item"
                                   href="/dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <!-- Notifications -->
                            <li>
                                <a class="dropdown-item"
                                   href="/notifications">

                                    <span class="dropdown-icon">🔔</span>
                                    Notifications
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <!-- Logout -->
                            <li>
                                <button class="dropdown-item text-danger"
                                        type="button"
                                        @onclick="HandleLogout">

                                    <span class="dropdown-icon">🚪</span>
                                    Logout
                                </button>
                            </li>

                        </ul>
                    </div>
                }
                else
                {
                    <!-- Guest -->
                    <a class="btn btn-outline-light btn-sm"
                       href="/login">
                        Login
                    </a>

                    <a class="btn btn-primary btn-sm"
                       href="/register">
                        Register
                    </a>
                }

            </div>

        </div>
    </div>
</nav>

<style>


    /* ============================
           Notification
           ============================ */

    .nav-notification {
        display: flex;
        align-items: center;
    }


</style>

@code {

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        Auth.AuthChanged += OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetDisplayName()
    {
        if (string.IsNullOrWhiteSpace(Auth.UserEmail))
            return "User";

        var parts = Auth.UserEmail.Split('@');

        var name = parts[0];

        return name.Length > 15
            ? name.Substring(0, 15) + "..."
            : name;
    }

    private string GetInitial()
    {
        if (string.IsNullOrWhiteSpace(Auth.UserEmail))
            return "U";

        return Auth.UserEmail
            .Substring(0, 1)
            .ToUpper();
    }

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();

        Navigation.NavigateTo(
            "/",
            forceLoad: true);
    }

    public void Dispose()
    {
        Auth.AuthChanged -= OnAuthChanged;
    }
}