@using BuildFlow.Web.Services
@inject BuildFlow.Web.Services.Auth.IAuthService Auth
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 py-3">
	<a class="navbar-brand" href="/">BuildFlow</a>
	<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
		<span class="navbar-toggler-icon"></span>
	</button>

	<div class="collapse navbar-collapse" id="navbarNav">
		<ul class="navbar-nav me-auto">
			<li class="nav-item">
				<NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink>
			</li>
			@if (Auth.IsAuthenticated)
			{
				<li class="nav-item">
					<NavLink class="nav-link" href="/dashboard">Dashboard</NavLink>
				</li>
			}
		</ul>

		<div class="d-flex align-items-center gap-3">
			@if (Auth.IsAuthenticated)
			{
				<!-- Notification Bell -->
				<NotificationBell />

				<!-- User Menu Dropdown -->
				<div class="dropdown">
					<button class="btn btn-outline-light btn-sm dropdown-toggle" 
							type="button" 
							id="userMenuDropdown" 
							data-bs-toggle="dropdown" 
							aria-expanded="false">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
						@GetDisplayName()
					</button>
					<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
						<li>
							<a class="dropdown-item" href="/users">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: -2px;">
									<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
								My Profile
							</a>
						</li>
						<li><hr class="dropdown-divider"></li>
						<li>
							<button class="dropdown-item" @onclick="HandleLogout">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: -2px;">
									<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
									<polyline points="16 17 21 12 16 7"></polyline>
									<line x1="21" y1="12" x2="9" y2="12"></line>
								</svg>
								Logout
							</button>
						</li>
					</ul>
				</div>
			}
			else
			{
				<a class="btn btn-outline-light btn-sm" href="/login">Login</a>
				<a class="btn btn-primary btn-sm" href="/register">Register</a>
			}
		</div>
	</div>

</nav>

@code {
	protected override async Task OnInitializedAsync()
	{
		await Auth.InitializeAsync();
		Auth.AuthChanged += StateHasChanged;
	}

	private string GetDisplayName()
	{
		if (string.IsNullOrWhiteSpace(Auth.UserEmail))
			return "User";

		var parts = Auth.UserEmail.Split('@');
		return parts[0].Length > 12 ? parts[0].Substring(0, 12) + "..." : parts[0];
	}

	private async Task HandleLogout()
	{
		await Auth.LogoutAsync();
		Navigation.NavigateTo("/");
	}
}
