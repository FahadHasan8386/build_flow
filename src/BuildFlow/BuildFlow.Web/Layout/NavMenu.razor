@using BuildFlow.Web.Services.Auth
@implements IDisposable

@inject IAuthService Auth
@inject NavigationManager Navigation

<div class="p-3">
    <h4 class="text-white mb-4 fw-bold">BuildFlow</h4>

    @if (Auth.IsAuthenticated)
    {
        <p class="text-secondary small fw-bold mb-2">WORKSPACE</p>

        <NavLink href="/home" class="nav-link text-white mb-1" Match="NavLinkMatch.All">
            Dashboard
        </NavLink>

        <NavLink href="/projects" class="nav-link text-white mb-1">
            Projects
        </NavLink>

        <NavLink href="/tasks" class="nav-link text-white mb-1">
            My Tasks
        </NavLink>

        <NavLink href="/team" class="nav-link text-white mb-3">
            Team Members
        </NavLink>

        <hr class="border-secondary" />

        <button class="btn btn-outline-light w-100" @onclick="Logout">
            Logout
        </button>
    }
    else
    {
        <p class="text-secondary small fw-bold mb-2">GET STARTED</p>

        <NavLink href="/login" class="nav-link text-white mb-1">
            Login
        </NavLink>

        <NavLink href="/register" class="nav-link text-white">
            Register
        </NavLink>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Auth.AuthChanged += OnAuthChanged;
        await Auth.InitializeAsync();
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Auth.AuthChanged -= OnAuthChanged;
    }
}