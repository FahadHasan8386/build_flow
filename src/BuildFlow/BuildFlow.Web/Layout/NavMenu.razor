@using BuildFlow.Web.Services.Auth
@implements IDisposable

@inject IAuthService Auth
@inject NavigationManager Navigation

<div class="p-3">

    <h4 class="text-white mb-4">BuildFlow</h4>

    @if (Auth.IsAuthenticated)
    {
        <p class="text-secondary">WORKSPACE</p>

        <NavLink href="/home" class="nav-link text-white">
            Dashboard
        </NavLink>

        <!-- Projects Dropdown -->
        <button class="bf-dropdown-btn"
                @onclick="ToggleProjects">
            <span>Projects</span>
            <span>@(projectsOpen ? "▾" : "▸")</span>
        </button>

        @if (projectsOpen)
        {
            <div class="bf-submenu">
                <NavLink href="/projects" class="nav-link">
                    All Projects
                </NavLink>

                <NavLink href="/projects/create" class="nav-link">
                    Create Project
                </NavLink>

                <NavLink href="/projects/get-by-id" class="nav-link">
                    Get Project By ID
                </NavLink>

                <NavLink href="/projects/update" class="nav-link">
                    Update Project
                </NavLink>

                <NavLink href="/projects/delete" class="nav-link">
                    Delete Project
                </NavLink>
            </div>
        }

        <NavLink href="/tasks" class="nav-link text-white">
            My Tasks
        </NavLink>

        <NavLink href="/team" class="nav-link text-white">
            Team Members
        </NavLink>

        <hr />

        <button class="btn btn-outline-light w-100"
                @onclick="Logout">
            Logout
        </button>
    }
    else
    {
        <p class="text-secondary">GET STARTED</p>

        <NavLink href="/login" class="nav-link text-white">
            Login
        </NavLink>

        <NavLink href="/register" class="nav-link text-white">
            Register
        </NavLink>
    }

</div>

@code {
    private bool projectsOpen;

    private void ToggleProjects()
    {
        projectsOpen = !projectsOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthChanged += OnAuthChanged;
        await Auth.InitializeAsync();
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Auth.AuthChanged -= OnAuthChanged;
    }
}
